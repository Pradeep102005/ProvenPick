# ─────────────────────────────────────────────────────────────────────────────
# ProvenPick — Environment Variables
# Copy this file to .env and fill in your real values
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Comma-separated YouTube channel IDs to monitor daily
# Example: UCxxxxxx,UCyyyyyy,UCzzzzzz
MONITORED_CHANNEL_IDS=

# ── Databases ────────────────────────────────────────────────────────────────
WORKFLOW_DATABASE_URL=postgresql+asyncpg://provenpick:provenpick123@localhost:5432/provenpick_workflow
STAGING_DATABASE_URL=postgresql+asyncpg://provenpick:provenpick123@localhost:5433/provenpick_staging
PRODUCTION_DATABASE_URL=postgresql+asyncpg://provenpick:provenpick123@localhost:5434/provenpick_production

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Queue names
PIPELINE_QUEUE=provenpick:pipeline_queue
STAGING_QUEUE=provenpick:staging_queue

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=provenpick123

# ── Amazon Associates ─────────────────────────────────────────────────────────
# Apply at: https://affiliate-program.amazon.in/
AMAZON_AFFILIATE_TAG=your_tag-21

# ── Discord Notifications ─────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Staging API ───────────────────────────────────────────────────────────────
STAGING_API_URL=http://localhost:8001
STAGING_API_SECRET=staging_secret_change_me

# ── Production API ────────────────────────────────────────────────────────────
PRODUCTION_API_URL=http://localhost:8002

# ── Scheduler ────────────────────────────────────────────────────────────────
# Time to run daily channel scan (24h format, IST)
SCAN_HOUR=6
SCAN_MINUTE=0
